￼ {
box-sizing: border-box;
margin: 0;
padding: 0;
font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
-webkit-tap-highlight-color: transparent;
}
body {
background-color: #0b0f19;
color: #f1f5f9;
display: flex;
justify-content: center;
min-height: 100vh;
overflow-x: hidden;
}
.app-container {
width: 100%;
max-width: 430px;
min-height: 100vh;
position: relative;
background-color: #0f172a;
display: flex;
flex-direction: column;
}
.screen {
display: none;
flex-direction: column;
height: 100vh;
padding: 20px;
box-sizing: border-box;
}
.screen.active {
display: flex;
}
/* HERO & HEADERS */
.hero {
text-align: center;
margin-top: 20px;
margin-bottom: 25px;
}
.logo-badge {
width: 60px;
height: 60px;
background: linear-gradient(135deg, #10b981, #059669);
border-radius: 16px;
display: flex;
align-items: center;
justify-content: center;
font-size: 1.5rem;
font-weight: 900;
margin: 0 auto 12px auto;
box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
}
h1 {
font-size: 2.2rem;
font-weight: 800;
letter-spacing: -1px;
color: #ffffff;
}
.tagline {
color: #94a3b8;
font-size: 0.95rem;
margin-top: 4px;
}
/* CARDS */
.card {
background-color: #1e293b;
border: 1px solid #334155;
border-radius: 16px;
padding: 16px;
margin-bottom: 16px;
}
.rules-card h3 {
color: #facc15;
font-size: 1rem;
margin-bottom: 8px;
}
.rules-card ul {
padding-left: 20px;
font-size: 0.85rem;
color: #cbd5e1;
line-height: 1.5;
}
.form-card {
display: flex;
flex-direction: column;
gap: 8px;
}
.form-card label {
font-size: 0.85rem;
color: #94a3b8;
}
input[type="text"] {
width: 100%;
padding: 14px;
border-radius: 10px;
border: 1px solid #334155;
background-color: #0f172a;
color: #fff;
font-size: 1rem;
outline: none;
}
input[type="text"]:focus {
border-color: #10b981;
}
/* BUTTONS */
.btn-primary {
width: 100%;
padding: 16px;
border-radius: 12px;
border: none;
background: linear-gradient(135deg, #10b981, #059669);
color: #fff;
font-weight: 700;
font-size: 1rem;
cursor: pointer;
box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
margin-top: auto;
}
.btn-secondary {
width: 100%;
padding: 14px;
border-radius: 12px;
border: 1px solid #334155;
background-color: #1e293b;
color: #fff;
font-weight: 600;
margin-top: 10px;
}
.btn-danger {
width: 100%;
padding: 14px;
border-radius: 12px;
border: none;
background-color: #ef4444;
color: #fff;
font-weight: 600;
margin-top: 10px;
}
/* MAP SCREEN */
#screen-map {
padding: 0;
position: relative;
}
.top-bar {
position: absolute;
top: 12px;
left: 12px;
right: 12px;
z-index: 1000;
background: rgba(30, 41, 59, 0.9);
backdrop-filter: blur(8px);
padding: 12px 16px;
border-radius: 12px;
border: 1px solid #334155;
display: flex;
justify-content: space-between;
align-items: center;
}
.user-info {
display: flex;
justify-content: space-between;
width: 100%;
align-items: center;
font-weight: 600;
}
.badge {
background-color: #10b981;
color: #0f172a;
padding: 4px 8px;
border-radius: 20px;
font-size: 0.8rem;
font-weight: 800;
}
#map {
width: 100%;
height: 100%;
z-index: 1;
}
.bottom-nav {
position: absolute;
bottom: 12px;
left: 12px;
right: 12px;
z-index: 1000;
background: rgba(30, 41, 59, 0.9);
backdrop-filter: blur(8px);
padding: 8px;
border-radius: 16px;
border: 1px solid #334155;
display: flex;
gap: 8px;
}
.nav-btn {
flex: 1;
padding: 12px;
background: transparent;
border: none;
color: #94a3b8;
font-weight: 600;
border-radius: 10px;
}
.nav-btn.active {
background-color: #334155;
color: #fff;
}
/* MODAL MISJI */
.modal {
display: none;
position: fixed;
top: 0;
left: 0;
width: 100%;
height: 100%;
background: rgba(0,0,0,0.7);
z-index: 2000;
align-items: center;
justify-content: center;
padding: 20px;
box-sizing: border-box;
}
.modal-content {
background-color: #1e293b;
border: 1px solid #334155;
border-radius: 20px;
padding: 20px;
width: 100%;
max-width: 360px;
position: relative;
}
.close-btn {
position: absolute;
right: 16px;
top: 12px;
font-size: 1.5rem;
color: #94a3b8;
cursor: pointer;
}
.mission-desc {
font-size: 0.9rem;
color: #cbd5e1;
margin: 12px 0;
line-height: 1.4;
}
.mission-reward {
font-size: 0.85rem;
color: #facc15;
margin-bottom: 12px;
}
.answer-box {
display: flex;
flex-direction: column;
gap: 10px;
}
.feedback-msg {
margin-top: 10px;
font-size: 0.85rem;
text-align: center;
font-weight: 600;
}
.feedback-msg.success { color: #10b981; }
.feedback-msg.error { color: #ef4444; }
/* PROFILE SCREEN */
.profile-card {
display: flex;
flex-direction: column;
gap: 12px;
}
.stat-row {
display: flex;
justify-content: space-between;
border-bottom: 1px solid #334155;
padding-bottom: 8px;
font-size: 0.9rem;
}
.stat-row:last-child {
border-bottom: none;
}